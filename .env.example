# ProofPay Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=development

# DEMO MODE (NOT authentication). Roles are chosen via the x-demo-role header.
# POST /api/v1/demo/reset only works when NODE_ENV != production AND DEMO_MODE=true.
# Never set DEMO_MODE=true on a deployment that holds real data.
DEMO_MODE=true
DATABASE_URL="file:./dev.db"

# PayPal REST API v2 Sandbox Configuration
# Provide sandbox client credentials from developer.paypal.com
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# Google Gemini API
# Server-side integration only
GEMINI_API_KEY=""

# Client Application URL
FRONTEND_URL="http://localhost:5173"

# --- Gemini (optional tuning; see docs/AI_SECURITY_AND_SCORING.md) ---
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # only used when the primary returns 404
# GEMINI_TIMEOUT_MS=30000      # per attempt, enforced via AbortSignal (1000-120000)
# GEMINI_MAX_ATTEMPTS=3        # total attempts incl. corrective retries (1-4)
# AI_MAX_CONCURRENT_CALLS=3    # simultaneous Gemini calls; extras get HTTP 429
